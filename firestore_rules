rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'at2026@gmail.com';
    }

    function isTech() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/config/technicians) &&
        request.auth.token.email in
        get(/databases/$(database)/documents/config/technicians).data.emails;
    }

    // ── Orders ────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin() || isTech()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isAdmin() || isTech() ||
        request.auth.uid == resource.data.userId
      );
      allow delete: if isAdmin();
    }

    // ── Enquiry / Visit Bookings ──────────────────────────────────────────
    match /enquiry/{docId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin() || isTech()
      );
      allow delete: if isAdmin();
    }

    // ── Config (plants, packages, gallery, contact etc) ───────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
      allow read: if isAdmin() || isTech();
    }

    // ── Gallery ───────────────────────────────────────────────────────────
    match /gallery/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Logs ──────────────────────────────────────────────────────────────
    match /logs/{doc} {
      allow write: if request.auth != null;
      allow read: if isAdmin() || isTech();
    }
  }
}
