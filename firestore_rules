rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders — customer sees only their own; admin sees all
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == 'at2026@gmail.com'
      );
      allow write: if request.auth != null;
    }

    // Enquiry / Visit Bookings — any signed-in user can book; admin reads all
    match /enquiry/{docId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == 'at2026@gmail.com'
      );
      allow delete: if request.auth != null &&
        request.auth.token.email == 'at2026@gmail.com';
    }

    // Config (plants, packages, gallery, contact etc) — public read, admin write only
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == 'at2026@gmail.com';
    }

    // User profiles — owner reads/writes their own; admin reads all
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
      allow read: if request.auth != null &&
        request.auth.token.email == 'at2026@gmail.com';
    }

    // Gallery — public read, admin write only
    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == 'at2026@gmail.com';
    }

    // Logs — any signed-in user writes; admin reads
    match /logs/{doc} {
      allow write: if request.auth != null;
      allow read: if request.auth != null &&
        request.auth.token.email == 'at2026@gmail.com';
    }

  }
}
